# Copy to .env and fill in what you need. Every variable is optional.
# DEMO_MODE=1 runs a scripted replay that needs no API key and no network.
DEMO_MODE=0

# Provider selected in the sidebar at start: openai or anthropic.
LLM_PROVIDER=openai

# API key for the provider you use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Model IDs offered in the sidebar.
OPENAI_MODEL=gpt-4o
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_SMALL_MODEL=claude-haiku-5-5

# Code execution limits per tool call.
CODE_TIMEOUT_S=30
MAX_OUTPUT_BYTES=20000

# Maximum number of code executions the agent may run for one question.
MAX_AGENT_ITERATIONS=10
